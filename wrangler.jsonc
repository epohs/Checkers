{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkers",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",

  // Static client. single-page-application makes any unmatched path
  // (notably /g/<code>) serve index.html; run_worker_first: true routes
  // everything through the Worker so it can canonical-redirect the
  // workers.dev host and own the WebSocket endpoint before assets answer.
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameDO" },
      { "name": "NAMES", "class_name": "NameRegistryDO" }
    ]
  },

  // SQLite-backed classes: required on the free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameDO", "NameRegistryDO"] }
  ]
}
